{
  "name": "coalesce-design-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:one": "vite --config one/vite.config.ts",
    "dev:two": "vite --config two/vite.config.ts",
    "dev:three": "vite --config three/vite.config.ts",
    "typecheck:one": "tsc --noEmit -p one/tsconfig.json",
    "typecheck:two": "tsc --noEmit -p two/tsconfig.json",
    "typecheck:three": "tsc --noEmit -p three/tsconfig.json",
    "build:one": "npm run typecheck:one && vite build --config one/vite.config.ts",
    "build:two": "npm run typecheck:two && vite build --config two/vite.config.ts",
    "build:three": "npm run typecheck:three && vite build --config three/vite.config.ts",
    "build": "npm run build:one && npm run build:two && npm run build:three",
    "preview:one": "vite preview --config one/vite.config.ts",
    "preview:two": "vite preview --config two/vite.config.ts",
    "preview:three": "vite preview --config three/vite.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  }
}
