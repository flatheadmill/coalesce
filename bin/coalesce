#!/usr/bin/env zshctl

# TODO Make `:::` configurable, so if you need `:::` as an argument use `@@@`
# instead, for example.
function _coalesce_job_yaml {
    typeset job=${1:-}
    shift
    typeset container containers=()
    typeset args=() arg image
    for arg in "${(@QA)${(z)_coalesce[${job}:args]}}" ":::"; do
        if [[ $arg = ":::" ]]; then
            eval "$(args -@ -- "${(@)args}")"
            image=${1:-}
            shift
            container=$(
                gojq --yaml-input \
                    --argjson args "$(jo \
                        name=${job##*.} \
                        image=$image \
                        cmd="$(jo  -a -- "$@" < /dev/null)" \
                 )" \
                '
                    .command = $args.cmd |
                    .image = $args.image |
                    .name = $args.name
                ' <({
                    heredoc <<'                    EOF'
                        name: null
                        image: null
                        command: []
                        env: []
                        args: []
                    EOF
                })
            )
            containers+=( $container )
        else
            args+=( $arg )
        fi
    done
    typeset name=${o_slug}-$(_coalesce_cksum $o_slug.$job)-${job##*.}
    typeset labels=$(
        jo -- flatheadmill.github.io/job=$job flatheadmill.github.io/slug=$o_slug
    )
    k8s[yaml]=$(
        gojq --yaml-input --yaml-output \
            --argjson args "$(jo \
                name=$name \
                labels=$labels \
                namespace=default \
                containers="$(jo  -a -- "${(@)containers}" < /dev/null)" \
         )" \
        '
            .metadata.name = $args.name |
            .metadata.namespace = $args.namespace |
            .metadata.labels = $args.labels |
            .spec.template.spec.containers = $args.containers
        '  <({
            heredoc <<'            EOF'
                apiVersion: batch/v1
                kind: Job
                metadata:
                  name: null
                  namespace: null
                  labels: {}
                spec:
                  backoffLimit: 0
                  ttlSecondsAfterFinished: 300
                  template:
                    spec:
                      restartPolicy: Never
                      containers: []
            EOF
        })
    )
    # gojq -c --yaml-input <<< $yaml
}

function _coalesce_check_job {
    typeset job=${1:-} child
    shift
    integer dirty
    case $_coalesce[${job}:kind]:$_coalesce[${job}:parallel] in
    (sync:0)
        _coalesce_descend_jobs ${job} || return 1
        ;;
    (sync:1)
        for child in "${(@AQ)${(z)_coalesce[${job}:queue]}}"; do
            _coalesce_check_job ${job}.${child}
            dirty=$?
        done
        (( dirty )) && return 1 || true
        ;;
    (pod:*)
        if (( ! ${+_coalesce[${job}:over]} )); then
            runnable+=( $job )
            return 1
        fi
        ;;
    esac
}

function _coalesce_descend_jobs {
    typeset dag=${1:-} queue=() node
    shift
    queue=( "${(@AQ)${(z)_coalesce[${dag}:queue]}}" )
    for node in "${(@)queue}"; do
        _coalesce_check_job ${dag}.${node} || return 1
    done
}

function _coalesce_run_start_jobs {
    typeset job
    typeset -A k8s
    for job in "${(@)runnable}"; do
        (( ${+_coalesce[${job}:ran]} )) && continue
        _coalesce_job_yaml $job
        # TODO Check with app if there is a metadata.json.
        kubectl apply -f - <<< $k8s[yaml]
        _coalesce[${job}:ran]=1
    done
}

function _coalesce_run {
    typeset runnable=() tape=()
    typeset event_type key value outcome
    typeset -A labels
    _coalesce_descend_jobs coalesce
    _coalesce_run_start_jobs
    integer fd child entries completed over
    while (( ! _coalesce[over] )); do
        coproc kubectl get jobs -l flatheadmill.github.io/slug=$o_slug \
            --watch --output-watch-events --output json
        child=${!}
        _coalesce_children+=( $child )
        exec {fd}<&p;
        coproc :
        while read -r line; do
            tape=( "${(@QA)${(z)$(
                jq -r '[
                    .type,
                    (.object.metadata.name),
                    (.object.metadata.namespace),
                    (.object.metadata.labels | length),
                    (.object.metadata.labels | to_entries[] | (.key, .value)),
                    ((.object.status.conditions // [{}])[] | (.type // "Pending"))
                ] | @sh'<<< $line
            )}}" )
            set -- "${(@)tape}"
            event_type=${1:-} entries=${4:-}
            shift 4
            while (( entries-- )); do
                key=${1:-} value=${2:-}
                shift 2
                labels[$key]=$value
            done
            outcome=${1:-}
            shift
            completed=0
            case $outcome in
            (Pending) ;;
            (Failed) ;;
            (Complete)
                print complete $labels[flatheadmill.github.io/job]
                completed=1
                _coalesce[$labels[flatheadmill.github.io/job]:over]=1
                ;;
            esac
            if (( completed )); then
                runnable=()
                _coalesce_descend_jobs coalesce
                if (( ${#runnable} )); then
                    _coalesce_run_start_jobs
                else
                    over=1
                    for key in "${(@k)_coalesce}"; do
                        [[ $key = *:ran ]] || continue
                        if (( ! ${+_coalesce[${key%%:*}:over]} )); then
                            over=0
                            break
                        fi
                    done
                    if (( over )); then
                        kill $child
                        wait $child
                        _coalesce[over]=1
                        break
                    fi
                fi
            fi
        done <&${fd}
        _coalesce_children=()
    done
    print exiting
}

function _coalesce_dag_descend_json {
    typeset dag=${1:-} queue=() node
    shift
    queue=( "${(@AQ)${(z)_coalesce[${dag}:queue]}}" )
    for node in "${(@)queue}"; do
        case $_coalesce[${dag}.${node}:kind] in
        (sync)
            jo -- name=$node under=${dag} kind=sync -b parallel=$_coalesce[${dag}.${node}:parallel]
            _coalesce_dag_descend_json ${dag}.${node}
            ;;
        (pod)
            jo -- name=$node under=${dag} kind=node
            ;;
        esac
    done
}

function _coalesce_dag_json {
    _coalesce_dag_descend_json coalesce
}

# TODO Global variables do not help, just serialize into an associative array
# and then you can use `:` as a delimiter allowing the user to use snake case.
function step {
    # first parse the placement args.
    eval "$(args n,name u,under -b s,sync p,parallel -- "$@")"
    typeset node pod split=() under=() join=( coalesce ) queue=()
    if [[ -v o_under ]]; then
        join=( coalesce "${(As:/:)o_under}" )
    fi
    under="${(j:.:)join}"
    if (( o_sync )); then
        (( ${+_coalesce[${under}:queue]} )) || abend "no such node to put under"
        _coalesce[${under}.${o_name}:queue]=
        queue=( "${(@AQ)${(z)_coalesce[${under}:queue]}}" )
        queue+=( $o_name )
        _coalesce[${under}:queue]="${(@qq)queue}"
        _coalesce[${under}.${o_name}:kind]=sync
        _coalesce[${under}.${o_name}:parallel]=$o_parallel
    else
        (( ${+_coalesce[${under}:queue]} )) || abend "no such node to put under"
        typeset args=( "$@" )
        eval "$(args e,env -- "$@")"
        queue=( "${(@AQ)${(z)_coalesce[${under}:queue]}}" )
        queue+=( $o_name )
        _coalesce[${under}:queue]="${(@qq)queue}"
        _coalesce[${under}.${o_name}:kind]=pod
        _coalesce[${under}.${o_name}:args]=${(j: :)${(@qq)args}}
    fi
}

function _coalesce_cksum {
    typeset -i16 hex_var=$(printf '%s' ${1:-} | cksum | cut -d' ' -f1)
    print ${hex_var[4,-1]:l}
}

function execute {
    eval "$(args -s s,slug -- "$@")"
    [[ -v o_slug ]] || abned 'slug is not defined'
    typeset -A _coalesce=( coalesce:queue '' over 0 )
    typeset _coalesce_children=()
    function TRAPTERM {
        typeset child
        _coalesce[over]=1
        for child in "${(@)_coalesce_children}"; do
            kill $child
        done
    }
    source $1
    _coalesce_run
    exit
    _coalesce_dag_json | jq --slurp '
      . as $all |
      def find_children($path):
        $all[] |
        select(.under == $path) |
        . as $node |
        . + {
          children: [
            $all | find_children(
              if $path == null then $node.name
              else $path + "." + $node.name
              end
            )
          ]
        };

      [find_children("coalesce")]
    '
}

# vim: ft=zsh :
