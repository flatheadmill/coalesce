#!/usr/bin/env zshctl

#apiVersion: batch/v1
#kind: Job
#  metadata:
#  name: coalesce-printer
#namespace: coalesce
#  spec:
#    ttlSecondsAfterFinished: 3600
#    template:
#      spec:
#        restartPolicy: Never
#        containers:
#        - name: printer
#          image: alpine
#          command: ["sh", "-c", "for n in $(seq 1 10); do echo $n; sleep 1; done"]

function _coalesce_dag_descend_json {
    typeset dag=${1:-} queue=() node
    shift
    typeset parts=( "$@" )
    queue=( "${(@AQ)${(z)_coalesce_node[$dag]}}" )
    for node in "${(@)queue}"; do
        case $_coalesce_node[${dag}_${node}:kind] in
        (sync)
            jo -- name=$node under=${dag} kind=sync -b parallel=$_coalesce_node[${dag}_${node}:parallel]
            _coalesce_dag_descend_json ${dag}-${node} "${(@)parts}" $node
            ;;
        (pod)
            jo -- name=$node under=${dag} kind=node
            ;;
        esac
    done
}

function _coalesce_dag_json {
    _coalesce_dag_descend_json coalesce
}

# TODO Global variables do not help, just serialize into an associative array
# and then you can use `:` as a delimiter allowing the user to use snake case.
function step {
    # first parse the placement args.
    eval "$(args n,name u,under -b s,sync p,parallel -- "$@")"
    typeset node pod split=() under=() join=( coalesce ) queue=()
    if [[ -v o_under ]]; then
        join=( coalesce "${(As:/:)o_under}" )
    fi
    under="${(j:-:)join}"
    if (( o_sync )); then
        (( ${+_coalesce_node[$under]} )) || abend "no such node to put under"
        _coalesce_node[$under-$o_name]=
        queue=( "${(@AQ)${(z)_coalesce_node[$under]}}" )
        queue+=( $o_name )
        _coalesce_node[$under]="${(@qq)queue}"
        _coalesce_node[${under}_${o_name}:kind]=sync
        _coalesce_node[${under}_${o_name}:parallel]=$o_parallel
    else
        (( ${+_coalesce_node[$under]} )) || abend "no such node to put under"
        typeset args=( "$@" )
        eval "$(args e,env -- "$@")"
        queue=( "${(@AQ)${(z)_coalesce_node[$under]}}" )
        queue+=( $o_name )
        _coalesce_node[$under]="${(@qq)queue}"
        _coalesce_node[${under}_${o_name}:kind]=pod
        _coalesce_node[${under}_${o_name}:args]=${(j: :)${(@qq)args}}
    fi
}

function execute {
    typeset -A _coalesce_node=( coalesce '' )
    source $1
    _coalesce_dag_json | jq --slurp '
      . as $all |
      def find_children($path):
        $all[] |
        select(.under == $path) |
        . as $node |
        . + {
          children: [
            $all | find_children(
              if $path == null then $node.name
              else $path + "-" + $node.name
              end
            )
          ]
        };

      [find_children("coalesce")]
    '
}

# vim: ft=zsh :
